        {
          "type": "text",
          "id": "wc67d",
          "name": "Overview Body",
          "fill": "#6F665D",
          "textGrowth": "fixed-width",
          "width": 700,
          "content": "홈을 달력 중심 화면으로 두고, 기존 달력 탭은 외부 레시피 링크를 모아두는 레시피 공간으로 대체한다. 모바일은 하단 탭, 데스크톱은 사이드바를 사용한다.",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "500"
        }
      ]
    },
